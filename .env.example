# Open Kattis credentials used by autokattis (do not commit .env.local)
KATTIS_USERNAME=your_kattis_username
KATTIS_PASSWORD=your_kattis_password

# Optional: set to "true" to include partially solved problems
KATTIS_SHOW_PARTIAL=false

# Optional: override python executable if autokattis is installed in a specific virtualenv
# PYTHON_BIN=/path/to/python3
